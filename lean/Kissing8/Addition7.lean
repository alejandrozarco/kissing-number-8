import Kissing8.Addition6

/-! Solid Gegenbauer addition identities from `ℝ^7` to `ℝ^6`, degrees `k ≤ 6`.

Generated by `lean/gen/gen_addition8.py` (every identity is first checked with sympy). Do not edit; regenerate.

For `x = (a, y)`, `x' = (a', y')` with `y, y' ∈ ℝ^6`, `w = ⟪y, y'⟫`, `P = ‖y‖²`, `Q = ‖y'‖²`:
`Zg 7 k ⟪x, x'⟫ ‖x‖² ‖x'‖² = ∑_{m ≤ k} cA7 k m · B(a) · B(a') · Z_m(w, P, Q)` with
`B(a) = Zg (7 + 2m) (k - m) a ‖x‖² 1` and `Z_m` the kernel of `ℝ^6`. -/

namespace Kissing8

/-- The coefficients of the identities from `ℝ^7` (`0` outside `m ≤ k ≤ 6`). -/
noncomputable def cA7 : ℕ → ℕ → ℝ
  | 0, 0 => 1
  | 1, 0 => 1/5
  | 1, 1 => 5/4
  | 2, 0 => 1/30
  | 2, 1 => 5/14
  | 2, 2 => 35/24
  | 3, 0 => 1/210
  | 3, 1 => 15/224
  | 3, 2 => 35/72
  | 3, 3 => 105/64
  | 4, 0 => 1/1680
  | 4, 1 => 5/504
  | 4, 2 => 7/72
  | 4, 3 => 105/176
  | 4, 4 => 231/128
  | 5, 0 => 1/15120
  | 5, 1 => 5/4032
  | 5, 2 => 35/2376
  | 5, 3 => 175/1408
  | 5, 4 => 1155/1664
  | 5, 5 => 1001/512
  | 6, 0 => 1/151200
  | 6, 1 => 1/7392
  | 6, 2 => 35/19008
  | 6, 3 => 175/9152
  | 6, 4 => 495/3328
  | 6, 5 => 1001/1280
  | 6, 6 => 2145/1024
  | _, _ => 0

theorem cA7_nonneg (k m : ℕ) : 0 ≤ cA7 k m := by
  unfold cA7
  split <;> norm_num

theorem add7_0 (a a' w P Q : ℝ) :
    Zg 7 0 (a * a' + w) (a * a + P) (a' * a' + Q) = ∑ m ∈ Finset.range 1,
      cA7 0 m * Zg (7 + 2 * m) (0 - m) a (a * a + P) 1 * Zg (7 + 2 * m) (0 - m) a' (a' * a' + Q) 1
        * Zg 6 m w P Q := by
  simp only [Finset.sum_range_succ, Finset.sum_range_zero, Nat.reduceAdd, Nat.reduceMul, Nat.reduceSub]
  simp only [cA7, Zg]
  push_cast
  ring

