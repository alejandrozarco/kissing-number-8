import Kissing8.Addition7

/-! Solid Gegenbauer addition identities from `ℝ^8` to `ℝ^7`, degrees `k ≤ 6`.

Generated by `lean/gen/gen_addition8.py` (every identity is first checked with sympy). Do not edit; regenerate.

For `x = (a, y)`, `x' = (a', y')` with `y, y' ∈ ℝ^7`, `w = ⟪y, y'⟫`, `P = ‖y‖²`, `Q = ‖y'‖²`:
`Zg 8 k ⟪x, x'⟫ ‖x‖² ‖x'‖² = ∑_{m ≤ k} cA8 k m · B(a) · B(a') · Z_m(w, P, Q)` with
`B(a) = Zg (8 + 2m) (k - m) a ‖x‖² 1` and `Z_m` the kernel of `ℝ^7`. -/

namespace Kissing8

/-- The coefficients of the identities from `ℝ^8` (`0` outside `m ≤ k ≤ 6`). -/
noncomputable def cA8 : ℕ → ℕ → ℝ
  | 0, 0 => 1
  | 1, 0 => 1/6
  | 1, 1 => 6/5
  | 2, 0 => 1/42
  | 2, 1 => 3/10
  | 2, 2 => 48/35
  | 3, 0 => 1/336
  | 3, 1 => 1/20
  | 3, 2 => 72/175
  | 3, 3 => 32/21
  | 4, 0 => 1/3024
  | 4, 1 => 1/150
  | 4, 2 => 144/1925
  | 4, 3 => 32/63
  | 4, 4 => 128/77
  | 5, 0 => 1/30240
  | 5, 1 => 1/1320
  | 5, 2 => 4/385
  | 5, 3 => 80/819
  | 5, 4 => 320/539
  | 5, 5 => 256/143
  | 6, 0 => 1/332640
  | 6, 1 => 1/13200
  | 6, 2 => 6/5005
  | 6, 3 => 80/5733
  | 6, 4 => 64/539
  | 6, 5 => 96/143
  | 6, 6 => 4096/2145
  | _, _ => 0

theorem cA8_nonneg (k m : ℕ) : 0 ≤ cA8 k m := by
  unfold cA8
  split <;> norm_num

theorem add8_0 (a a' w P Q : ℝ) :
    Zg 8 0 (a * a' + w) (a * a + P) (a' * a' + Q) = ∑ m ∈ Finset.range 1,
      cA8 0 m * Zg (8 + 2 * m) (0 - m) a (a * a + P) 1 * Zg (8 + 2 * m) (0 - m) a' (a' * a' + Q) 1
        * Zg 7 m w P Q := by
  simp only [Finset.sum_range_succ, Finset.sum_range_zero, Nat.reduceAdd, Nat.reduceMul, Nat.reduceSub]
  simp only [cA8, Zg]
  push_cast
  ring

