import Kissing8.Addition5

/-! Solid Gegenbauer addition identities from `ℝ^6` to `ℝ^5`, degrees `k ≤ 6`.

Generated by `lean/gen/gen_addition8.py` (every identity is first checked with sympy). Do not edit; regenerate.

For `x = (a, y)`, `x' = (a', y')` with `y, y' ∈ ℝ^5`, `w = ⟪y, y'⟫`, `P = ‖y‖²`, `Q = ‖y'‖²`:
`Zg 6 k ⟪x, x'⟫ ‖x‖² ‖x'‖² = ∑_{m ≤ k} cA6 k m · B(a) · B(a') · Z_m(w, P, Q)` with
`B(a) = Zg (6 + 2m) (k - m) a ‖x‖² 1` and `Z_m` the kernel of `ℝ^5`. -/

namespace Kissing8

/-- The coefficients of the identities from `ℝ^6` (`0` outside `m ≤ k ≤ 6`). -/
noncomputable def cA6 : ℕ → ℕ → ℝ
  | 0, 0 => 1
  | 1, 0 => 1/4
  | 1, 1 => 4/3
  | 2, 0 => 1/20
  | 2, 1 => 4/9
  | 2, 2 => 8/5
  | 3, 0 => 1/120
  | 3, 1 => 2/21
  | 3, 2 => 3/5
  | 3, 3 => 64/35
  | 4, 0 => 1/840
  | 4, 1 => 1/63
  | 4, 2 => 2/15
  | 4, 3 => 128/175
  | 4, 4 => 128/63
  | 5, 0 => 1/6720
  | 5, 1 => 5/2268
  | 5, 2 => 1/45
  | 5, 3 => 64/385
  | 5, 4 => 160/189
  | 5, 5 => 512/231
  | 6, 0 => 1/60480
  | 6, 1 => 1/3780
  | 6, 2 => 1/330
  | 6, 3 => 32/1155
  | 6, 4 => 160/819
  | 6, 5 => 512/539
  | 6, 6 => 1024/429
  | _, _ => 0

theorem cA6_nonneg (k m : ℕ) : 0 ≤ cA6 k m := by
  unfold cA6
  split <;> norm_num

theorem add6_0 (a a' w P Q : ℝ) :
    Zg 6 0 (a * a' + w) (a * a + P) (a' * a' + Q) = ∑ m ∈ Finset.range 1,
      cA6 0 m * Zg (6 + 2 * m) (0 - m) a (a * a + P) 1 * Zg (6 + 2 * m) (0 - m) a' (a' * a' + Q) 1
        * Zg 5 m w P Q := by
  simp only [Finset.sum_range_succ, Finset.sum_range_zero, Nat.reduceAdd, Nat.reduceMul, Nat.reduceSub]
  simp only [cA6, Zg]
  push_cast
  ring

