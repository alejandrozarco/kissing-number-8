import Kissing8.Kernel

/-! Solid Gegenbauer addition identities from `ℝ^3` to `ℝ^2`, degrees `k ≤ 6`.

Generated by `lean/gen/gen_addition8.py` (every identity is first checked with sympy). Do not edit; regenerate.

For `x = (a, y)`, `x' = (a', y')` with `y, y' ∈ ℝ^2`, `w = ⟪y, y'⟫`, `P = ‖y‖²`, `Q = ‖y'‖²`:
`Zg 3 k ⟪x, x'⟫ ‖x‖² ‖x'‖² = ∑_{m ≤ k} cA3 k m · B(a) · B(a') · Z_m(w, P, Q)` with
`B(a) = Zg (3 + 2m) (k - m) a ‖x‖² 1` and `Z_m` the kernel of `ℝ^2` (Chebyshev, `Zc`). -/

namespace Kissing8

/-- The coefficients of the identities from `ℝ^3` (`0` outside `m ≤ k ≤ 6`). -/
noncomputable def cA3 : ℕ → ℕ → ℝ
  | 0, 0 => 1
  | 1, 0 => 1
  | 1, 1 => 1
  | 2, 0 => 1/2
  | 2, 1 => 2/3
  | 2, 2 => 3/2
  | 3, 0 => 1/6
  | 3, 1 => 1/4
  | 3, 2 => 9/10
  | 3, 3 => 15/4
  | 4, 0 => 1/24
  | 4, 1 => 1/15
  | 4, 2 => 3/10
  | 4, 3 => 15/7
  | 4, 4 => 105/8
  | 5, 0 => 1/120
  | 5, 1 => 1/72
  | 5, 2 => 1/14
  | 5, 3 => 75/112
  | 5, 4 => 175/24
  | 5, 5 => 945/16
  | 6, 0 => 1/720
  | 6, 1 => 1/420
  | 6, 2 => 3/224
  | 6, 3 => 25/168
  | 6, 4 => 35/16
  | 6, 5 => 2835/88
  | 6, 6 => 10395/32
  | _, _ => 0

theorem cA3_nonneg (k m : ℕ) : 0 ≤ cA3 k m := by
  unfold cA3
  split <;> norm_num

theorem add3_0 (a a' w P Q : ℝ) :
    Zg 3 0 (a * a' + w) (a * a + P) (a' * a' + Q) = ∑ m ∈ Finset.range 1,
      cA3 0 m * Zg (3 + 2 * m) (0 - m) a (a * a + P) 1 * Zg (3 + 2 * m) (0 - m) a' (a' * a' + Q) 1
        * Zc m w P Q := by
  simp only [Finset.sum_range_succ, Finset.sum_range_zero, Nat.reduceAdd, Nat.reduceMul, Nat.reduceSub]
  simp only [cA3, Zg, Zc]
  push_cast
  ring

