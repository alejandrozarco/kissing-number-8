theorem rows_sep : rows.Pairwise Sep :=
  rowsFrom_sep0

theorem P_sep : ∀ i j, i ≠ j →
    4 ≤ (P i 0 - P j 0) ^ 2 + (P i 1 - P j 1) ^ 2 + (P i 2 - P j 2) ^ 2 + (P i 3 - P j 3) ^ 2 +
      (P i 4 - P j 4) ^ 2 + (P i 5 - P j 5) ^ 2 + (P i 6 - P j 6) ^ 2 + (P i 7 - P j 7) ^ 2 := by
  intro i j hij
  have h := List.pairwise_iff_getElem.mp rows_sep
  rcases Nat.lt_or_gt_of_ne (Fin.val_ne_of_ne hij) with hlt | hlt
  · exact h i.val j.val (by rw [rows_length]; exact i.isLt) (by rw [rows_length]; exact j.isLt) hlt
  · have h2 : 4 ≤ (P j 0 - P i 0) ^ 2 + (P j 1 - P i 1) ^ 2 + (P j 2 - P i 2) ^ 2 + (P j 3 - P i 3) ^ 2 +
        (P j 4 - P i 4) ^ 2 + (P j 5 - P i 5) ^ 2 + (P j 6 - P i 6) ^ 2 + (P j 7 - P i 7) ^ 2 :=
      h j.val i.val (by rw [rows_length]; exact j.isLt) (by rw [rows_length]; exact i.isLt) hlt
    have e : ∀ a b : ℤ, (a - b) ^ 2 = (b - a) ^ 2 := fun a b => by ring
    rw [e (P i 0) (P j 0), e (P i 1) (P j 1), e (P i 2) (P j 2), e (P i 3) (P j 3),
      e (P i 4) (P j 4), e (P i 5) (P j 5), e (P i 6) (P j 6), e (P i 7) (P j 7)]
    exact h2

/-- The `i`-th point. -/
noncomputable def pt (i : Fin 240) : EuclideanSpace ℝ (Fin 8) :=
  WithLp.toLp 2 fun k => (P i k : ℝ)

/-- A point of `ℝ⁸` whose squared coordinates sum to `4` has norm `2`. -/
lemma norm_eq_two {x : EuclideanSpace ℝ (Fin 8)}
    (h : x 0 ^ 2 + x 1 ^ 2 + x 2 ^ 2 + x 3 ^ 2 +
        x 4 ^ 2 + x 5 ^ 2 + x 6 ^ 2 + x 7 ^ 2 = 4) : ‖x‖ = 2 := by
  have hs : ‖x‖ ^ 2 = 4 := by
    rw [EuclideanSpace.real_norm_sq_eq, Fin.sum_univ_eight]
    exact h
  nlinarith [norm_nonneg x]

/-- Two points of `ℝ⁸` whose squared coordinate differences sum to at least `4` are at least `2` apart. -/
lemma two_le_dist {x y : EuclideanSpace ℝ (Fin 8)}
    (h : 4 ≤ (x 0 - y 0) ^ 2 + (x 1 - y 1) ^ 2 + (x 2 - y 2) ^ 2 + (x 3 - y 3) ^ 2 +
        (x 4 - y 4) ^ 2 + (x 5 - y 5) ^ 2 + (x 6 - y 6) ^ 2 + (x 7 - y 7) ^ 2) :
    2 ≤ dist x y := by
  rw [dist_eq_norm]
  have hs : 4 ≤ ‖x - y‖ ^ 2 := by
    rw [EuclideanSpace.real_norm_sq_eq, Fin.sum_univ_eight]
    simpa only [PiLp.sub_apply] using h
  nlinarith [norm_nonneg (x - y)]

theorem norm_pt (i : Fin 240) : ‖pt i‖ = 2 := by
  apply norm_eq_two
  simp only [pt, PiLp.toLp_apply]
  exact_mod_cast P_norm i

theorem dist_pt (i j : Fin 240) (hij : i ≠ j) : 2 ≤ dist (pt i) (pt j) := by
  apply two_le_dist
  simp only [pt, PiLp.toLp_apply]
  exact_mod_cast P_sep i j hij

theorem pt_injective : Function.Injective pt := by
  intro i j h
  by_contra hij
  have := dist_pt i j hij
  rw [h, dist_self] at this
  norm_num at this

end TwoForty
end Kissing8
