theorem rows_length : rows.length = 240 := by
  decide +kernel

/-- The coordinates of the `i`-th point. -/
def P (i : Fin 240) : Fin 8 → ℤ :=
  rows[i.val]'(by rw [rows_length]; exact i.isLt)

theorem P_mem (i : Fin 240) : P i ∈ rows :=
  List.getElem_mem _

theorem rows_norm : ∀ x ∈ rows, x 0 ^ 2 + x 1 ^ 2 + x 2 ^ 2 + x 3 ^ 2 +
      x 4 ^ 2 + x 5 ^ 2 + x 6 ^ 2 + x 7 ^ 2 = 4 := by
  decide +kernel

theorem P_norm : ∀ i, P i 0 ^ 2 + P i 1 ^ 2 + P i 2 ^ 2 + P i 3 ^ 2 +
      P i 4 ^ 2 + P i 5 ^ 2 + P i 6 ^ 2 + P i 7 ^ 2 = 4 :=
  fun i => rows_norm (P i) (P_mem i)

/-- `x` and `y` are at squared distance at least `4`. -/
abbrev Sep (x y : Fin 8 → ℤ) : Prop :=
  4 ≤ (x 0 - y 0) ^ 2 + (x 1 - y 1) ^ 2 + (x 2 - y 2) ^ 2 + (x 3 - y 3) ^ 2 +
      (x 4 - y 4) ^ 2 + (x 5 - y 5) ^ 2 + (x 6 - y 6) ^ 2 + (x 7 - y 7) ^ 2

instance : DecidableRel Sep := fun _ _ => Int.decLe _ _

