import Kissing8.Addition4

/-! Solid Gegenbauer addition identities from `ℝ^5` to `ℝ^4`, degrees `k ≤ 6`.

Generated by `lean/gen/gen_addition8.py` (every identity is first checked with sympy). Do not edit; regenerate.

For `x = (a, y)`, `x' = (a', y')` with `y, y' ∈ ℝ^4`, `w = ⟪y, y'⟫`, `P = ‖y‖²`, `Q = ‖y'‖²`:
`Zg 5 k ⟪x, x'⟫ ‖x‖² ‖x'‖² = ∑_{m ≤ k} cA5 k m · B(a) · B(a') · Z_m(w, P, Q)` with
`B(a) = Zg (5 + 2m) (k - m) a ‖x‖² 1` and `Z_m` the kernel of `ℝ^4`. -/

namespace Kissing8

/-- The coefficients of the identities from `ℝ^5` (`0` outside `m ≤ k ≤ 6`). -/
noncomputable def cA5 : ℕ → ℕ → ℝ
  | 0, 0 => 1
  | 1, 0 => 1/3
  | 1, 1 => 3/2
  | 2, 0 => 1/12
  | 2, 1 => 3/5
  | 2, 2 => 15/8
  | 3, 0 => 1/60
  | 3, 1 => 3/20
  | 3, 2 => 45/56
  | 3, 3 => 35/16
  | 4, 0 => 1/360
  | 4, 1 => 1/35
  | 4, 2 => 45/224
  | 4, 3 => 35/36
  | 4, 4 => 315/128
  | 5, 0 => 1/2520
  | 5, 1 => 1/224
  | 5, 2 => 25/672
  | 5, 3 => 35/144
  | 5, 4 => 1575/1408
  | 5, 5 => 693/256
  | 6, 0 => 1/20160
  | 6, 1 => 1/1680
  | 6, 2 => 5/896
  | 6, 3 => 35/792
  | 6, 4 => 1575/5632
  | 6, 5 => 2079/1664
  | 6, 6 => 3003/1024
  | _, _ => 0

theorem cA5_nonneg (k m : ℕ) : 0 ≤ cA5 k m := by
  unfold cA5
  split <;> norm_num

theorem add5_0 (a a' w P Q : ℝ) :
    Zg 5 0 (a * a' + w) (a * a + P) (a' * a' + Q) = ∑ m ∈ Finset.range 1,
      cA5 0 m * Zg (5 + 2 * m) (0 - m) a (a * a + P) 1 * Zg (5 + 2 * m) (0 - m) a' (a' * a' + Q) 1
        * Zg 4 m w P Q := by
  simp only [Finset.sum_range_succ, Finset.sum_range_zero, Nat.reduceAdd, Nat.reduceMul, Nat.reduceSub]
  simp only [cA5, Zg]
  push_cast
  ring

